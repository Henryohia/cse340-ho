
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <p><strong>Organization:</strong> 
        <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
    </p>

    <p><strong>Description:</strong> <%= projectDetails.description %></p>

    <p><strong>Date:</strong> <%= projectDetails.project_date %></p>

    <p><strong>Location:</strong> <%= projectDetails.location %></p>

    <!-- <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p> -->

    <% if (user) { %>
        <section class="volunteer-section">
            <% if (volunteeringStatus) { %>
                <form action="/project/<%= projectDetails.project_id %>/remove-volunteer" method="POST">
                    <button type="submit">Remove Volunteer</button>
                </form>
            <% } else { %>
                <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                    <button type="submit">Volunteer for this Project</button>
                </form>
            <% } %>
        </section>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
        <span> | </span>
        <a href="/assign-categories/<%= projectDetails.project_id %>">Assign Categories</a>
    <% } %>

    <h3>Categories</h3>

    <div class="categories">

        <% categories.forEach(category => { %>

            <a class="category-tag" href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>

        <% }) %>

    </div>


</main>



<%- include('partials/footer') %>