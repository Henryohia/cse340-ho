<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

<form action="/edit-project/{id}" method="POST">
    <div class="form-group">
      <label for="title">Project title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= projectDetails.name %>"
        required
        maxlength="150"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
        maxlength="500"
      ><%= projectDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        maxlength="255"
        required
        value="<%= projectDetails.location %>"
        
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        required
        value="<%= projectDetails.date %>"
        
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select
        type="text"
        id="organizationId"
        name="organizationId"
        maxlength="255"
        required
        value="<%= projectDetails.contact_email %>"
        
      >
      <option value="">Select an organization</option>
        <% organizations.forEach(org => { %>
          <option value="<%= org.organization_id %>"><%= org.name %></option>
        <% }); %>
      </select>
    </div>

    <button type="submit">Update Project</button>
  </form>

</main>
<%- include('partials/footer') %>